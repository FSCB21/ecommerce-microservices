{
  "name": "order-service",
  "version": "1.0.0",
  "description": "Microservicio de procesamiento y gestión de pedidos para la plataforma de comercio electrónico",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env POSTGRES_DB=orders_test_db node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/unit tests/api",
    "test:integration": "cross-env POSTGRES_DB=orders_test_db node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/integration",
    "db:seed": "npx sequelize-cli db:seed:all"
  },
  "dependencies": {
    "amqplib": "^2.3.3",
    "axios": "^1.21.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.2"
  }
}
