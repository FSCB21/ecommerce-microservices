
# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=your_rabbitmq_user
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Secreto JWT
JWT_SECRET=your_jwt_secret

# URLs de microservicios
USER_SERVICE_URL=http://localhost:3001/api
PRODUCT_SERVICE_URL=http://localhost:3002/api

# Configuración SMTP - Ethereal Email
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_ethereal_username
SMTP_PASSWORD=your_ethereal_password
SMTP_FROM="E-commerce Microservices <no-reply@example.com>"
